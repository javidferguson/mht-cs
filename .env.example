# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
# Mac (default): Ollama runs natively on the host for Metal GPU acceleration.
# The host needs NO OLLAMA_HOST override - Docker Desktop proxies
# host.docker.internal through to the default 127.0.0.1 bind (verified on
# Docker 29.7.2). Just run `ollama serve`.
# EC2 with `--profile ollama`: use http://ollama:11434 instead.
#
# NOTE: no trailing `# comments` on value lines - both make and docker compose
# read this file, and one of them keeps the comment as part of the value.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EXTRACTION_MODEL=llama3.1:8b
# OLLAMA_NUM_CTX caps the context window per slot. The model's default is
# 131072, which reserves ~22GB of KV cache per slot - at NUM_PARALLEL=8 that
# exceeds 64GB of unified memory. Extraction needs ~4k.
OLLAMA_NUM_CTX=4096

# Client-side semaphore ONLY. The host server needs its own, set when you start it:
#   OLLAMA_NUM_PARALLEL=8 ollama serve
# Without that the server runs -np 1 and serialises every request no matter what
# this value says. Measured on a 64GB M5 Max: 8 slots ~= 0.72 docs/s; 16 gives no
# further gain.
OLLAMA_NUM_PARALLEL=8

# Bounds generation. Two corpus documents drove the model into a repetition loop
# that never terminated; this makes such a run fail in seconds instead of hanging.
OLLAMA_NUM_PREDICT=1536

OLLAMA_TIMEOUT_S=180

# ---------------------------------------------------------------------------
# Data paths
# ---------------------------------------------------------------------------
# DATA_DIR is the host dir holding the input JSONL, mounted read-only at /data.
DATA_DIR=./data
INPUT_DIR=/data
OUT_DIR=/out

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# POSTGRES_PORT_HOST publishes the DB to the host for GUI tools only, bound to
# 127.0.0.1. The pipeline itself always uses POSTGRES_HOST/POSTGRES_PORT below
# (postgres:5432 on the compose network). Change this only if 5432 is taken.
POSTGRES_USER=mht
POSTGRES_PASSWORD=mht
POSTGRES_DB=mht
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5432

# ---------------------------------------------------------------------------
# Run knobs
# ---------------------------------------------------------------------------
# BENCH_N = docs timed by `make bench`. LIMIT caps `make extract` (blank = all).
BENCH_N=20
LIMIT=
JUPYTER_PORT=8888
